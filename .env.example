TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHECK_INTERVAL_SEC=3600
FAIL_THRESHOLD=1
RECOVERY_NOTIFY=true
ICMP_TIMEOUT_MS=1500
TCP_TIMEOUT_SEC=3
WEB_HOST=0.0.0.0
WEB_PORT=8099

# NVR login used to discover channels and open streams. Never returned to the browser.
NVR_USERNAME=admin
NVR_PASSWORD=
NVR_LOGIN_ATTEMPTS=
FFMPEG_PATH=ffmpeg
SNAPSHOT_CONCURRENCY=8

# Bunny.net Edge Storage for health-check images + remote dashboard sync
BUNNY_STORAGE_ZONE=uptime-monitor
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_READONLY_PASSWORD=
BUNNY_STORAGE_ENDPOINT=https://sg.storage.bunnycdn.com
BUNNY_IMAGE_RETENTION_DAYS=30
BUNNY_CDN_BASE_URL=

# Vercel read-only dashboard (form login page + session cookie)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Optional: set a dedicated session signing key in production
FLASK_SECRET_KEY=

# On-site live bridge (Cloudflare named tunnel → Vercel Check Live)
# Same LIVE_BRIDGE_TOKEN on site PC (.env) and on Vercel.
# LIVE_BRIDGE_URL = https://live.yourdomain.com  (no trailing slash)
LIVE_BRIDGE_TOKEN=
LIVE_BRIDGE_URL=
